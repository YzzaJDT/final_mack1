PORT=3001

CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE=

# Where each consultant gets emailed when someone books with them
JAZZY_EMAIL=
JAZEL_EMAIL=

# EmailJS (emailjs.com) — sends the "agent interest" announcement straight from the
# browser, no server email password needed. Create a free account, connect any
# email inbox as a "Service", make a template using the variables listed in
# src/Components/ContactAgent.jsx, then paste the three IDs below.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Default address that receives "someone is interested in your property" emails
VITE_AGENT_EMAIL=delatorrejazzy36@gmail.com
